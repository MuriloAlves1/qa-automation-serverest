# URL da API. Com localhost, o Playwright sobe o ServeRest local automaticamente.
API_URL=http://localhost:3000
# Para rodar contra o ambiente público: API_URL=https://serverest.dev

# URL do front-end (usado a partir da Fase 3)
UI_URL=https://front.serverest.dev

# Defina como false se você já subiu o ServeRest manualmente (npm run serverest)
START_LOCAL_SERVER=true
